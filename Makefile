# One entry point per task. Python = ML processing, Rust = orchestration, R = analysis.
.PHONY: proto test smoke analysis paper clean

PYTHON ?= python3
PROTO_FILES := $(shell find proto -name '*.proto')

# Generate Python bindings. Rust bindings are generated by orchestrator/build.rs.
proto:
	$(PYTHON) -m grpc_tools.protoc -I proto --python_out=worker/src/fedids_worker/gen $(PROTO_FILES)

test: proto
	cd worker && $(PYTHON) -m pytest

# Rust orchestrator -> Python worker -> Parquet -> R plot.
smoke: proto
	./scripts/smoke.sh

phase3:
	./scripts/run_table3_suite.sh

phase4:
	./scripts/run_fig2_defenses.sh

phase5:
	./scripts/run_sec5_5_robustness.sh

analysis:
	Rscript analysis/run_analysis.R
	@if [ -f runs/table3_results.parquet ]; then Rscript analysis/R/table3_analysis.R; fi
	@if [ -f runs/defense_pareto_results.parquet ]; then Rscript analysis/R/fig2_pareto.R; fi
	@if [ -f runs/sec5_5_robustness_results.parquet ]; then Rscript analysis/R/sec5_5_robustness.R; fi

plots:
	$(PYTHON) plots/generate_paper_plots.py

paper:
	cd paper && latexmk -pdf main.tex

clean:
	rm -rf runs/* worker/src/fedids_worker/gen/fedids orchestrator/target
	touch runs/.gitkeep

